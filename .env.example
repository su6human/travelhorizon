# Copy these to Render → your service → Environment. Never commit real values.

# Site Editor sign-in (password: at least 12 characters)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Telegram bot that receives enquiries (the same values as in your other project work here)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: topic id if the chat is a forum group
TELEGRAM_THREAD_ID=
# Optional: language of the Telegram message, ru (default) or en
TELEGRAM_MESSAGE_LANG=ru

# Production
NODE_ENV=production
# Persistent storage for edited text (Render disk mount path)
CONTENT_FILE=/var/data/content.json
